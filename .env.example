# --- Server ---
NODE_ENV=development
PORT=3000
# Where the web app runs (used for CORS and post-login redirect)
WEB_ORIGIN=http://localhost:5173

# --- Database (matches docker-compose.yml) ---
POSTGRES_USER=vinylshelf
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vinylshelf
DATABASE_URL=postgres://vinylshelf:change-me@localhost:5432/vinylshelf

# --- Sessions and encryption ---
# Generate each with: openssl rand -base64 32
SESSION_SECRET=
# Encrypts Discogs OAuth tokens at rest (32 random bytes, base64)
TOKEN_ENCRYPTION_KEY=

# --- Discogs (from discogs.com/settings/developers) ---
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
DISCOGS_CALLBACK_URL=http://localhost:3000/api/v1/auth/discogs/callback
# Discogs requires a descriptive User-Agent on every request
DISCOGS_USER_AGENT=VinylShelf/0.1 (+https://github.com/YOUR_USERNAME/YOUR_REPO)

# --- MusicBrainz (later; they require a descriptive User-Agent) ---
MUSICBRAINZ_USER_AGENT=VinylShelf/0.1 ( your-email@example.com )

# --- Recognition (later) ---
# Use "fake" for dev and tests so you don't spend the free quota
RECOGNIZER=fake
AUDD_API_TOKEN=