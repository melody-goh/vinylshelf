# --- Server ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Where the web app runs (used for the Origin check and post-login redirects)
WEB_ORIGIN=http://localhost:5173

# --- Database (matches docker-compose.yml) ---
POSTGRES_USER=vinylshelf
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vinylshelf
DATABASE_URL=postgres://vinylshelf:change-me@localhost:5432/vinylshelf
# Created by docker/postgres/init on first start; integration tests reset it freely
TEST_DATABASE_URL=postgres://vinylshelf:change-me@localhost:5432/vinylshelf_test

# --- Encryption ---
# Encrypts Discogs OAuth tokens at rest and the OAuth request-token cookie (ADR 0006).
# 32 random bytes, base64. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Discogs data lifecycle (ADR 0004) ---
# Hard display deadline for cached Discogs data. Must be <= 21600 (6 hours); the API
# refuses to start otherwise. Lower it (e.g. 120) to test expiry by hand.
DISCOGS_CACHE_TTL_SECONDS=21600
# Age after which a shelf read starts a background refresh (stale-while-revalidate)
DISCOGS_REFRESH_AFTER_SECONDS=18000
# After a failed import, wait this long before refreshing automatically again
REFRESH_COOLDOWN_MINUTES=15

# --- Job queue (ADR 0003; lengthen these in production so the database can sleep) ---
QUEUE_POLLING_INTERVAL_SECONDS=2
CACHE_PURGE_CRON=*/15 * * * *

# --- Discogs (from discogs.com/settings/developers) ---
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=
DISCOGS_CALLBACK_URL=http://localhost:3000/api/v1/auth/discogs/callback
# Discogs requires a descriptive User-Agent on every request
DISCOGS_USER_AGENT=VinylShelf/0.1 (+https://github.com/YOUR_USERNAME/YOUR_REPO)

# --- MusicBrainz (later; they require a descriptive User-Agent) ---
MUSICBRAINZ_USER_AGENT=VinylShelf/0.1 ( your-email@example.com )

# --- Recognition (later) ---
# Use "fake" for dev and tests so you don't spend the free quota
RECOGNIZER=fake
AUDD_API_TOKEN=