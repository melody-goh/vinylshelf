{
  "name": "@vinylshelf/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --name",
    "db:migrate": "tsx scripts/migrate.ts",
    "fixtures:check": "tsx scripts/check-fixtures.ts",
    "models:fetch": "tsx scripts/models-fetch.ts",
    "catalogue:build": "tsx scripts/catalogue-build.ts",
    "catalogue:load": "tsx scripts/catalogue-load.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-kit": "^0.31.11",
    "msw": "^3.0.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@huggingface/transformers": "3.8.1",
    "@vinylshelf/contract": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "saxes": "6.0.0",
    "zod": "^4.6.7"
  }
